# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATA_DIR=.data
CRON_SECRET=change-me-in-production
SINGLE_USER_ID=00000000-0000-0000-0000-000000000001
# Supabase (optional — uses local JSON store when unset)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# YouTube Data API (OAuth for real publishing)
YOUTUBE_CLIENT_ID=your-google-client-id
YOUTUBE_CLIENT_SECRET=your-google-client-secret

# AI — multi-provider fallback (groq → gemini → openai). Templates if all unset.
# Script order (comma-separated):
AI_SCRIPT_PROVIDERS=groq,gemini,openai
# TTS order — edge is free cloud TTS, no key required:
AI_TTS_PROVIDERS=edge,openai
# Transcription order:
AI_TRANSCRIBE_PROVIDERS=groq,gemini,openai

# Groq (free tier — recommended primary)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# Google Gemini (free tier backup)
GEMINI_API_KEY=
# alias: GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (optional paid backup — skip to stay $0)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Edge TTS (free, no key) — Microsoft neural voices
EDGE_TTS_VOICE=en-US-JennyNeural
TTS_VOICE=alloy

# Footage Providers (optional — uses generated placeholder video)
PEXELS_API_KEY=your-pexels-key
PIXABAY_API_KEY=your-pixabay-key

# Optional: Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=

# Multi-platform cross-post (comma-separated: youtube,tiktok,instagram,facebook,linkedin,x)
DEFAULT_CROSS_POST_PLATFORMS=youtube

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_ACCESS_TOKEN=

# Meta (Instagram Reels + Facebook)
META_APP_ID=
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_PAGE_ID=

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:me

# X (Twitter)
X_API_BEARER_TOKEN=

# Google Drive / private Google Docs
GOOGLE_DRIVE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional profanity blocklist (comma-separated)
PROFANITY_BLOCKLIST=
